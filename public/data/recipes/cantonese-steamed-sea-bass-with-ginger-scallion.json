    "steps":  [
                  {
                      "title":  "Prep Steamer \u0026 Vegetables",
                      "description":  "Bring water to a boil in a steamer. Arrange halved baby bok choy on a heatproof ceramic plate."
                  },
                  {
                      "title":  "Steam Sea Bass",
                      "description":  "Place sea bass fillet over the bok choy. Scatter half the julienned ginger on top and steam for 8 minutes."
                  },
                  {
                      "title":  "Add Fresh Aromatics",
                      "description":  "Carefully remove the plate from the steamer. Scatter remaining julienned ginger and shredded scallions over the hot fish."
                  },
                  {
                      "title":  "Flash Hot Oil",
                      "description":  "Heat sesame oil and olive oil in a small pan until smoking hot. Pour sizzling oil directly over scallions and ginger."
                  },
                  {
                      "title":  "Drizzle Tamari \u0026 Serve",
                      "description":  "Drizzle tamari soy sauce around the base of the fish and greens. Serve immediately while aromatic."
                  }
              ]
