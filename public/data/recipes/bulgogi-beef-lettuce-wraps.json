    "steps":  [
                  {
                      "title":  "Prepare Marinade",
                      "description":  "In a shallow dish, whisk together tamari soy sauce, toasted sesame oil, minced garlic, and grated ginger."
                  },
                  {
                      "title":  "Marinate Beef",
                      "description":  "Add thinly sliced sirloin steak to the marinade. Toss thoroughly to coat and rest for 15 minutes."
                  },
                  {
                      "title":  "Sear Sirloin",
                      "description":  "Heat a heavy skillet over high heat. Sear marinated sirloin in a single layer for 2 minutes until browned."
                  },
                  {
                      "title":  "Prep Lettuce Cups",
                      "description":  "Separate and wash crisp Romaine lettuce leaves. Pat dry and arrange across a serving plate."
                  },
                  {
                      "title":  "Assemble \u0026 Garnish",
                      "description":  "Divide seared beef among lettuce cups. Top each cup with tangy kimchi and finely sliced scallions."
                  }
