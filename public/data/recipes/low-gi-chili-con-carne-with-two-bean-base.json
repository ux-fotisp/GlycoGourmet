                  {
                      "title":  "Sauté Aromatics",
                      "description":  "Heat olive oil in a heavy pot over medium heat. Sauté diced yellow onion and minced garlic until translucent."
                  },
                  {
                      "title":  "Brown Lean Beef",
                      "description":  "Add extra-lean ground beef to the pot, breaking up with a spoon until thoroughly browned."
                  },
                  {
                      "title":  "Add Beans \u0026 Tomatoes",
                      "description":  "Stir in rinsed black beans, red kidney beans, and crushed canned tomatoes."
                  },
                  {
                      "title":  "Simmer Chili",
                      "description":  "Reduce heat to low, cover pot, and simmer gently for 25 minutes to develop rich, complex flavors."
                  },
                  {
                      "title":  "Rest \u0026 Serve",
                      "description":  "Uncover and let chili rest for 2 minutes off heat. Ladle into a bowl and serve hot."
