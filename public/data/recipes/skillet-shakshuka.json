    "steps":  [
                  {
                      "title":  "Sauté Garlic \u0026 Pepper",
                      "description":  "Heat olive oil in a wide skillet over medium heat. Sauté diced bell pepper and minced garlic until softened."
                  },
                  {
                      "title":  "Simmer Tomato Sauce",
                      "description":  "Add halved cherry tomatoes. Simmer gently for 8 minutes, crushing tomatoes with a wooden spoon into a thick sauce."
                  },
                  {
                      "title":  "Create Egg Wells",
                      "description":  "Use a spoon to create small hollow wells in the bubbling tomato sauce."
                  },
                  {
                      "title":  "Crack Eggs into Wells",
                      "description":  "Crack fresh eggs directly into each well in the sauce."
                  },
                  {
                      "title":  "Cover \u0026 Poach",
                      "description":  "Cover skillet and cook on low heat for 5 minutes until egg whites set and yolks remain runny."
                  }
              ]
