    "steps":  [
                  {
                      "title":  "Prep Salmon \u0026 Asparagus",
                      "description":  "Pat salmon fillet completely dry with paper towels. Trim woody ends from fresh asparagus spears and mince garlic clove."
                  },
                  {
                      "title":  "Sear Salmon Skin",
                      "description":  "Heat olive oil in a skillet over medium-high heat. Place salmon skin-side down, pressing firmly for 30 seconds for crispness."
                  },
                  {
                      "title":  "Add Asparagus \u0026 Garlic",
                      "description":  "Add trimmed asparagus spears and minced garlic to the pan around the salmon, sautéing until fragrant."
                  },
                  {
                      "title":  "Flip \u0026 Baste",
                      "description":  "Flip salmon fillet carefully and cook for 3 more minutes until flesh flakes easily and asparagus is tender-crisp."
                  },
                  {
                      "title":  "Finish with Lemon",
                      "description":  "Transfer crispy salmon and asparagus to a warm plate. Squeeze fresh lemon juice over top and serve."
                  }
              ]
