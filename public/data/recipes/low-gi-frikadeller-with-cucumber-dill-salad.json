                  {
                      "title":  "Soak Oats \u0026 Mix Meat",
                      "description":  "Soak rolled oats in warm water for 5 minutes. Combine with lean minced meat, beaten egg, and minced onion."
                  },
                  {
                      "title":  "Shape Patties",
                      "description":  "Form meat mixture into 3 smooth, uniform oval patties with moistened hands."
                  },
                  {
                      "title":  "Quick Pickle Cucumber",
                      "description":  "Shave cucumber thinly. Toss with fresh chopped dill, a splash of vinegar, and a pinch of salt."
                  },
                  {
                      "title":  "Pan-Sear Frikadeller",
                      "description":  "Heat olive oil in a skillet over medium heat. Fry patties for 5 to 6 minutes per side until golden brown."
                  },
                  {
                      "title":  "Plate \u0026 Serve",
                      "description":  "Transfer hot frikadeller patties to a plate and serve alongside the chilled cucumber-dill salad."
