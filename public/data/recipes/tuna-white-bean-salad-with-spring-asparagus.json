    "steps":  [
                  {
                      "title":  "Blanch Asparagus",
                      "description":  "Blanch cut asparagus pieces in boiling salted water for 2 minutes, then plunge into ice water and drain."
                  },
                  {
                      "title":  "Emulsify Dressing",
                      "description":  "Whisk extra virgin olive oil, fresh lemon juice, and Dijon mustard in a salad bowl until smooth."
                  },
                  {
                      "title":  "Add Beans \u0026 Vegetables",
                      "description":  "Add drained cannellini beans, blanched asparagus, and finely diced red onion to the dressing bowl."
                  },
                  {
                      "title":  "Fold Flaked Tuna",
                      "description":  "Add drained tuna chunks and fold gently with a spoon to coat without breaking up beans."
                  },
                  {
                      "title":  "Season \u0026 Plate",
                      "description":  "Season lightly with black pepper and serve salad chilled or at room temperature."
