# ==============================================================================
# GlycoGourmet — Render Demo Environment Configuration (.env.example)
# Target Environment: Public Demonstration Only (Synthetic Data)
#
# HARD SECURITY RULES:
# - NEVER commit, print, or place actual secret values in git or PRs.
# - Secrets must be generated locally or via Render dashboard and stored ONLY in Render.
# - Never use 'Password123!' as a deployed demo credential.
# ==============================================================================

# --- Application Runtime (Safe Defaults) ---
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# --- Database Connection (Managed PostgreSQL on Render) ---
# Set DATABASE_CLIENT to postgres. DATABASE_URL is linked from Render managed
# PostgreSQL via Blueprint (fromDatabase property connectionString).
# DO NOT hardcode database URLs or passwords in git.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true

# Alternative individual PostgreSQL connection parameters:
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=glycogourmet
# DATABASE_USERNAME=glycogourmet_user
# DATABASE_PASSWORD=

# --- Strapi Security Secrets (STORE ONLY IN RENDER) ---
# Generate using cryptographically secure random generators (e.g. openssl rand -base64 32).
# These MUST be generated and stored ONLY in Render environment variables. Never commit!
JWT_SECRET=
ADMIN_JWT_SECRET=
APP_KEYS=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# --- Demonstration & Credential Safety (SG-1 / SG-3) ---
# PUBLIC_DEPLOYMENT=true activates the security guard in server/seed.js, strictly
# preventing default 'Password123!' from being seeded.
PUBLIC_DEPLOYMENT=true

# SEED_PASSWORD must be a strong, non-default password generated specifically for the demo,
# or left unset in Render to force server/seed.js to auto-generate per-role random passwords
# logged once to deploy output. NEVER set to 'Password123!'.
SEED_PASSWORD=

# --- Cross-Origin Resource Sharing (CORS) ---
# Explicitly bound to the deployed Netlify frontend domain.
# Wildcard domains (*.netlify.app) combined with credentials are strictly forbidden.
CORS_ORIGIN=https://glycogourmet.netlify.app

# --- Frontend Client Build Setting (Netlify) ---
# VITE_ENABLE_DEMO_AUTH MUST be false on all deployed builds.
# Demo users must authenticate through the real demo Strapi API.
VITE_ENABLE_DEMO_AUTH=false
