{
  "name": "glycogourmet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src/",
    "typecheck": "npx --package typescript tsc --noEmit",
    "precommit": "npm run lint && npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y/contrastAudit.spec.ts",
    "validate-db": "node scripts/validateNutritionDatabase.js",
    "seed:content": "node scripts/seedNewRecipes.js",
    "test:integration:docker": "docker-compose up -d --build && npm run test:integration:wait && docker-compose down",
    "test:integration:wait": "npx vitest run tests/integration/TenantScopingIntegration.spec.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.34.0",
    "oxlint": "^1.71.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
