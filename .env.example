# Snappi CMS API Configuration
# ─── Public Read Access ───
VITE_SNAPPI_API_BASE=https://your-instance.snappi.io/api/v1
VITE_SNAPPI_READ_TOKEN=your-read-only-api-key

# ─── NOTE ───
# User JWTs for write/publish operations are managed via the
# AuthContext session and injected dynamically by snappiClient.js.
# Do NOT store user JWTs here.
