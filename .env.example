# Strapi Headless CMS REST API Configuration
# ─── Public & Authenticated API Base URL ───
# Strapi backend REST API base URL.
# NOTE: Vite bakes this value into the client bundle at build time;
# changing it in deployed environments requires a rebuild/redeploy, not just a refresh.
# Live Demo Backend: https://glycogourmet-demo-api.onrender.com (Render + PostgreSQL)
# For full demo environment architecture, seeded accounts, and CORS setup,
# see docs/DEMO-ENVIRONMENT.md.
# For local development: http://localhost:1337
VITE_STRAPI_API_URL=https://glycogourmet-demo-api.onrender.com
VITE_STRAPI_TOKEN=your-read-only-api-token

# ─── Authentication & Security ───
# User JWTs for write/publish operations are managed via AuthContext
# and stored in client localStorage (strapi_jwt / glyco_jwt).
# Do NOT store user JWTs or secrets here.
# VITE_ENABLE_DEMO_AUTH must be false in all deployed environments.
VITE_ENABLE_DEMO_AUTH=false
