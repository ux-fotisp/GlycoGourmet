ts {\n  .glyco-input { width: 100%; background-color: var(--color-surface-container-lowest); border: 1px solid var(--color-outline-variant); border-radius: 0.75rem; height: 3rem; padding-left: 1rem; padding-right: 1rem; font-size: 0.875rem; color: var(--color-on-surface); outline: none; transition: border-color 0.15s, box-shadow 0.15s; }\n  .glyco-input:focus {\n  border-color: var(--color-primary); box-shadow: color-mix(in srgb, rgb(50, 83, 70) 15%, transparent) 0px 0px 0px 3px;\n  @supports (color: color-mix(in lab, red, red)) {\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);\n}\n}\n  .glyco-input::placeholder { color: var(--color-on-surface-variant); opacity: 0.55; }\n  .glyco-badge { display: inline-flex; flex-direction: column; align-items: center; padding: 0.75rem 1rem; background-color: var(--color-surface-container-low); border: 1px solid transparent; border-radius: 0.75rem; transition: border-color 0.15s, transform 0.15s; gap: 0.125rem; }\n  .glyco-badge:hover { border-color: var(--color-primary-fixed-dim); transform: translateY(-1px); }\n  .glyco-badge__value { font-size: 1.25rem; font-weight: 700; color: var(--color-primary); line-height: 1.1; }\n  .glyco-badge__value--gi { color: var(--color-tertiary); }\n  .glyco-badge__label { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-on-surface-variant); }\n  .bento-cell { background-color: white; border: 1px solid var(--color-outline-variant); border-radius: 0.875rem; padding: 1rem 1.25rem; transition: box-shadow 0.2s, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); }\n  .bento-cell:hover { box-shadow: rgba(45, 49, 48, 0.08) 0px 12px 30px; transform: translateY(-2px); }\n  .bento-cell--active {\n  border-color: var(--color-primary); background-color: color-mix(in srgb, rgb(50, 83, 70) 4%, white);\n  @supports (color: color-mix(in lab, red, red)) {\n  background-color: color-mix(in srgb, var(--color-primary) 