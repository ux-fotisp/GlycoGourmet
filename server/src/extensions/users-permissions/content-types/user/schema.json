{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "Extended Strapi User content-type with RBAC, Admin Approval Workflow & Dietitian credentials",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "isApproved": {
      "type": "boolean",
      "default": false,
      "configurable": true,
      "description": "Admin approval flag controlling active application access"
    },
    "roleType": {
      "type": "enumeration",
      "enum": [
        "user",
        "dietitian",
        "admin"
      ],
      "default": "user",
      "configurable": true,
      "description": "Clinical role assignment for RBAC permissions"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "configurable": true,
      "description": "Whether the user has completed the onboarding flow"
    },
    "licenseId": {
      "type": "string",
      "configurable": true,
      "description": "Professional license identifier (dietitian role only)"
    },
    "credential": {
      "type": "enumeration",
      "enum": [
        "RDN",
        "CDCES",
        "LDN",
        "MD"
      ],
      "configurable": true,
      "description": "Professional credential type (dietitian role only)"
    },
    "clinicName": {
      "type": "string",
      "configurable": true,
      "description": "Affiliated clinic or practice name (dietitian role only)"
    },
    "auditNotes": {
      "type": "text",
      "configurable": true,
      "description": "Internal notes for administrator during account review"
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    }
  }
}